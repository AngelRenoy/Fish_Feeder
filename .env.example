# =============================================================================
# Environment Configuration Template for IoT Automatic Fish Feeder
# Copy this file to .env before starting Docker Compose:
# Windows PowerShell: Copy-Item .env.example .env
# Linux / macOS:      cp .env.example .env
# =============================================================================

# PostgreSQL Credentials & Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fishfeeder_secret_pw
POSTGRES_DB=fishfeeder
POSTGRES_PORT=5433

# FastAPI Backend Port exposed to host machine & local Wi-Fi
BACKEND_PORT=8000

# Environment Mode (development / production)
ENVIRONMENT=production

# SQLite fallback (set to true only for offline local Python testing without Docker)
USE_SQLITE=false

